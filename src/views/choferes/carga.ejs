<%- include('../partials/head', { titulo: 'Cargar Chofer', hojaEstilo: 'choferes-carga' }) %>

<div class="app-shell" id="appShell">
  <%- include('../partials/topbar', { usuario: usuario, notificaciones: notificaciones }) %>
  <%- include('../partials/sidebar', { activeModulo: 'choferes' }) %>

  <main class="app-main" style="overflow-y:auto">
    <div class="form-page">

      <a href="/choferes" class="btn btn-sm btn-ghost btn-page-back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        Volver a Choferes
      </a>

      <div class="form-page-header">
        <div>
          <h1>Cargar Chofer</h1>
          <p>Complete los datos personales, laborales y de licencia del nuevo conductor.</p>
        </div>
      </div>

      <form action="/choferes/nuevo" method="post" enctype="multipart/form-data">

        <section class="form-section">
          <h2>Información Básica</h2>
          <div class="form-row">
            <div class="form-group"><label>Nombre <span class="req">*</span></label><input name="nombre" type="text" placeholder="Ej: Juan" required></div>
            <div class="form-group"><label>Apellido <span class="req">*</span></label><input name="apellido" type="text" placeholder="Ej: Pérez" required></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label>DNI <span class="req">*</span></label><input name="dni" type="text" placeholder="Sin puntos" required></div>
            <div class="form-group"><label>Fecha de Nacimiento</label><input name="fechaNacimiento" type="date"></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label>Teléfono</label><input name="telefono" type="tel" placeholder="Código de área + número"></div>
            <div class="form-group"><label>E-mail (Opcional)</label><input name="email" type="email" placeholder="correo@ejemplo.com"></div>
          </div>
          <div class="form-group"><label>Dirección</label><input name="direccion" type="text" placeholder="Calle y número"></div>

          <p class="field-hint" style="margin-top:var(--space-4)">DNI <span class="tag-muted">(foto o fotocopia)</span></p>
          <div class="form-row">
            <div class="form-group">
              <div class="upload-box"><label for="dni_frente">Frente</label><input type="file" id="dni_frente" name="dni_frente" accept="image/*,.pdf"></div>
              <div class="upload-preview" data-preview-for="dni_frente">Sin archivo seleccionado</div>
            </div>
            <div class="form-group">
              <div class="upload-box"><label for="dni_dorso">Dorso</label><input type="file" id="dni_dorso" name="dni_dorso" accept="image/*,.pdf"></div>
              <div class="upload-preview" data-preview-for="dni_dorso">Sin archivo seleccionado</div>
            </div>
          </div>
        </section>

        <section class="form-section">
          <h2>Datos Laborales</h2>
          <div class="form-row">
            <div class="form-group"><label>Fecha de Ingreso</label><input name="fechaIngreso" type="date"></div>
            <div class="form-group">
              <label>Turno</label>
              <select name="turno">
                <option value="">Seleccionar</option>
                <option>Mañana</option>
                <option>Tarde</option>
                <option>Tarde/Noche</option>
                <option>Noche</option>
              </select>
            </div>
          </div>
        </section>

        <section class="form-section">
          <h2>Licencia Provincial</h2>
          <div class="form-row">
            <div class="form-group"><label>Número de Licencia</label><input name="numero_licencia" type="text" placeholder="Ingrese el N° de licencia"></div>
            <div class="form-group">
              <label>Categoría</label>
              <select name="categoria">
                <option value="">Seleccione categoría</option>
                <option value="A">A - Motocicletas</option>
                <option value="B1">B1 - Autos y camionetas</option>
                <option value="B2">B2 - Vehículos utilitarios</option>
                <option value="C">C - Camiones sin acoplado</option>
                <option value="D">D - Transporte de pasajeros</option>
                <option value="E">E - Camiones con acoplado</option>
                <option value="G">G - Maquinaria especial</option>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>Fecha de Retiro de la Licencia</label>
              <input name="fecha_emision" type="date">
              <span class="field-hint">La licencia provincial vence siempre el 31 de diciembre del año de retiro. Se calcula automáticamente.</span>
            </div>
          </div>
          <p class="field-hint" style="margin-top:var(--space-4)">Foto o fotocopia de la licencia</p>
          <div class="form-row">
            <div class="form-group">
              <div class="upload-box"><label for="licencia_provincial_frente">Frente</label><input type="file" id="licencia_provincial_frente" name="licencia_provincial_frente" accept="image/*,.pdf"></div>
              <div class="upload-preview" data-preview-for="licencia_provincial_frente">Sin archivo seleccionado</div>
            </div>
            <div class="form-group">
              <div class="upload-box"><label for="licencia_provincial_dorso">Dorso</label><input type="file" id="licencia_provincial_dorso" name="licencia_provincial_dorso" accept="image/*,.pdf"></div>
              <div class="upload-preview" data-preview-for="licencia_provincial_dorso">Sin archivo seleccionado</div>
            </div>
          </div>
        </section>

        <section class="form-section">
          <h2>Licencia Nacional <span class="tag-muted">(opcional)</span></h2>
          <div class="form-row">
            <div class="form-group"><label>Número de Licencia</label><input name="numero_licencia_nacional" type="text" placeholder="Ingrese el N° de licencia"></div>
            <div class="form-group">
              <label>Categoría</label>
              <select name="categoria_nacional">
                <option value="">Seleccione categoría</option>
                <option value="A">A - Motocicletas</option>
                <option value="B1">B1 - Autos y camionetas</option>
                <option value="B2">B2 - Vehículos utilitarios</option>
                <option value="C">C - Camiones sin acoplado</option>
                <option value="D">D - Transporte de pasajeros</option>
                <option value="E">E - Camiones con acoplado</option>
                <option value="G">G - Maquinaria especial</option>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group"><label>Fecha de Emisión</label><input name="fecha_emision_nacional" type="date"></div>
            <div class="form-group"><label>Fecha de Vencimiento</label><input name="fecha_vencimiento_nacional" type="date"></div>
          </div>
          <p class="field-hint" style="margin-top:var(--space-4)">Foto o fotocopia de la licencia</p>
          <div class="form-row">
            <div class="form-group">
              <div class="upload-box"><label for="licencia_nacional_frente">Frente</label><input type="file" id="licencia_nacional_frente" name="licencia_nacional_frente" accept="image/*,.pdf"></div>
              <div class="upload-preview" data-preview-for="licencia_nacional_frente">Sin archivo seleccionado</div>
            </div>
            <div class="form-group">
              <div class="upload-box"><label for="licencia_nacional_dorso">Dorso</label><input type="file" id="licencia_nacional_dorso" name="licencia_nacional_dorso" accept="image/*,.pdf"></div>
              <div class="upload-preview" data-preview-for="licencia_nacional_dorso">Sin archivo seleccionado</div>
            </div>
          </div>
        </section>

        <section class="form-section">
          <h2>Fotografía del Chofer</h2>
          <div class="upload-box">
            <label for="imagen">Haga clic aquí para subir la foto</label>
            <span>Formatos aceptados: JPG, PNG</span>
            <input type="file" id="imagen" name="imagen" accept="image/*">
          </div>
          <div class="upload-preview" data-preview-for="imagen">Sin imagen seleccionada</div>
        </section>

        <div class="form-actions">
          <a href="/choferes" class="btn btn-outline">Cancelar</a>
          <button type="submit" class="btn btn-accent">Guardar Chofer</button>
        </div>
      </form>
    </div>
  </main>
</div>

<script src="/js/pages/choferes-carga.js"></script>
<%- include('../partials/scripts') %>
