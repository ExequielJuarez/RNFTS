<%- include('../partials/head', { titulo: 'Cargar Chofer', estilosPagina: ['/css/forms.css'] }) %>

<div class="app-shell" id="appShell">
  <%- include('../partials/topbar', { usuario: usuario, notificaciones: notificaciones }) %>
  <%- include('../partials/sidebar', { activeModulo: 'choferes' }) %>

  <main class="app-main" style="overflow-y:auto">
    <div class="form-page">

      <a href="/choferes" class="btn btn-sm btn-ghost btn-page-back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        Volver a Choferes
      </a>

      <div class="form-page-header">
        <div>
          <h1>Cargar Chofer</h1>
          <p>Complete los datos personales, laborales y de licencia del nuevo conductor.</p>
        </div>
      </div>

      <form action="/choferes/nuevo" method="post" enctype="multipart/form-data">

        <section class="form-section">
          <h2>Información Básica</h2>
          <div class="form-row">
            <div class="form-group"><label>Nombre <span class="req">*</span></label><input name="nombre" type="text" placeholder="Ej: Juan" required></div>
            <div class="form-group"><label>Apellido <span class="req">*</span></label><input name="apellido" type="text" placeholder="Ej: Pérez" required></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label>DNI <span class="req">*</span></label><input name="dni" type="text" placeholder="Sin puntos" required></div>
            <div class="form-group"><label>Fecha de Nacimiento</label><input name="fechaNacimiento" type="date"></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label>Teléfono</label><input name="telefono" type="tel" placeholder="Código de área + número"></div>
            <div class="form-group"><label>E-mail (Opcional)</label><input name="email" type="email" placeholder="correo@ejemplo.com"></div>
          </div>
          <div class="form-group"><label>Dirección</label><input name="direccion" type="text" placeholder="Calle y número"></div>

          <div class="form-group" style="margin-top:var(--space-4)">
            <label>Foto del Documento (DNI)</label>
            <div class="upload-box">
              <label for="foto_documento">Haga clic aquí para subir foto del DNI</label>
              <span>Formatos aceptados: JPG, PNG</span>
              <input type="file" id="foto_documento" name="foto_documento" accept="image/*">
            </div>
            <div class="upload-preview" data-preview-for="foto_documento">Sin imagen seleccionada</div>
          </div>
        </section>

        <section class="form-section">
          <h2>Datos Laborales</h2>
          <div class="form-row">
            <div class="form-group"><label>Fecha de Ingreso</label><input name="fechaIngreso" type="date"></div>
            <div class="form-group">
              <label>Estado</label>
              <select name="estado">
                <option value="">Seleccionar</option>
                <option value="Activo">Activo</option>
                <option value="Inactivo">Inactivo</option>
                <option value="Licencia Vacaciones/Medica">Licencia Vacaciones/Médica</option>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>Turno</label>
              <select name="turno">
                <option value="">Seleccionar</option>
                <option>Mañana</option>
                <option>Tarde</option>
                <option>Tarde/Noche</option>
                <option>Noche</option>
              </select>
            </div>
            <div class="form-group"></div>
          </div>
        </section>

        <section class="form-section">
          <h2>Datos de Licencia de Conducir</h2>
          <div class="form-row">
            <div class="form-group"><label>Número de Licencia</label><input name="numero_licencia" type="text" placeholder="Ingrese el N° de licencia"></div>
            <div class="form-group">
              <label>Categoría</label>
              <select name="categoria">
                <option value="">Seleccione categoría</option>
                <option value="A">A - Motocicletas</option>
                <option value="B1">B1 - Autos y camionetas</option>
                <option value="B2">B2 - Vehículos utilitarios</option>
                <option value="C">C - Camiones sin acoplado</option>
                <option value="D">D - Transporte de pasajeros</option>
                <option value="E">E - Camiones con acoplado</option>
                <option value="G">G - Maquinaria especial</option>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group"><label>Fecha de Emisión</label><input name="fecha_emision" type="date"></div>
            <div class="form-group"><label>Fecha de Vencimiento</label><input name="fecha_vencimiento" type="date"></div>
          </div>
          <div class="form-group" style="margin-top:var(--space-4)">
            <label>Foto de la Licencia</label>
            <div class="upload-box">
              <label for="foto_licencia">Haga clic aquí para subir foto de la licencia</label>
              <span>Formatos aceptados: JPG, PNG</span>
              <input type="file" id="foto_licencia" name="foto_licencia" accept="image/*">
            </div>
            <div class="upload-preview" data-preview-for="foto_licencia">Sin imagen seleccionada</div>
          </div>
        </section>

        <section class="form-section">
          <h2>Fotografía del Chofer</h2>
          <div class="upload-box">
            <label for="imagen">Haga clic aquí para subir la foto</label>
            <span>Formatos aceptados: JPG, PNG</span>
            <input type="file" id="imagen" name="imagen" accept="image/*">
          </div>
          <div class="upload-preview" data-preview-for="imagen">Sin imagen seleccionada</div>
        </section>

        <section class="form-section">
          <h2>Fechas Administrativas <span class="tag-muted">(Opcionales)</span></h2>
          <div class="form-row">
            <div class="form-group"><label>Fecha de Alta en Sistema</label><input name="fecha_alta" type="date"></div>
            <div class="form-group"><label>Fecha de Baja</label><input name="fecha_baja" type="date"></div>
          </div>
        </section>

        <div class="form-actions">
          <a href="/choferes" class="btn btn-outline">Cancelar</a>
          <button type="submit" class="btn btn-accent">Guardar Chofer</button>
        </div>
      </form>
    </div>
  </main>
</div>

<%- include('../partials/scripts') %>
