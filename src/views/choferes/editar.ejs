<%- include('../partials/head', { titulo: 'Editar Chofer', hojaEstilo: 'choferes-editar' }) %>

<div class="app-shell" id="appShell">
  <%- include('../partials/topbar', { usuario: usuario, notificaciones: notificaciones }) %>
  <%- include('../partials/sidebar', { activeModulo: 'choferes' }) %>

  <main class="app-main" style="overflow-y:auto">
    <div class="form-page">

      <a href="/choferes/<%= chofer.id %>" class="btn btn-sm btn-ghost btn-page-back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        Volver a Choferes
      </a>

      <div class="form-page-header">
        <div>
          <h1>Editar Chofer</h1>
          <p>Modificá los datos de <%= chofer.nombre %> <%= chofer.apellido %>.</p>
        </div>
      </div>

      <% if (chofer.estado === 'Inactivo') { %>
        <div class="form-notice is-error">
          <span>Este chofer está Inactivo (<%= chofer.inactividad ? chofer.inactividad.motivoLabel : '—' %>). Para reactivarlo o cambiar el motivo, usá las acciones de la ficha del chofer.</span>
        </div>
      <% } %>

      <form action="/choferes/<%= chofer.id %>/editar" method="post" enctype="multipart/form-data">

        <section class="form-section">
          <h2>Información Básica</h2>
          <div class="form-row">
            <div class="form-group"><label>Nombre</label><input name="nombre" type="text" value="<%= chofer.nombre %>"></div>
            <div class="form-group"><label>Apellido</label><input name="apellido" type="text" value="<%= chofer.apellido %>"></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label>DNI <span class="tag-muted">(no modificable)</span></label><input name="dni" type="text" value="<%= chofer.dni %>" readonly class="readonly-field"></div>
            <div class="form-group"><label>Fecha de Nacimiento</label><input name="fechaNacimiento" type="date" value="<%= chofer.fechaNacimientoISO || '' %>"></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label>Teléfono</label><input name="telefono" type="tel" value="<%= chofer.telefono %>"></div>
            <div class="form-group"><label>E-mail</label><input name="email" type="email" value="<%= chofer.email || '' %>"></div>
          </div>
          <div class="form-group"><label>Dirección</label><input name="direccion" type="text" value="<%= chofer.direccion %>"></div>
        </section>

        <section class="form-section">
          <h2>Datos Laborales</h2>
          <div class="form-row">
            <div class="form-group"><label>Fecha de Ingreso</label><input name="fechaIngreso" type="date" value="<%= chofer.fechaIngresoISO || '' %>"></div>
            <div class="form-group">
              <label>Turno</label>
              <select name="turno">
                <option value="Mañana" <%= chofer.turno === 'Mañana' ? 'selected' : '' %>>Mañana</option>
                <option value="Tarde" <%= chofer.turno === 'Tarde' ? 'selected' : '' %>>Tarde</option>
                <option value="Tarde/Noche" <%= chofer.turno === 'Tarde/Noche' ? 'selected' : '' %>>Tarde/Noche</option>
                <option value="Noche" <%= chofer.turno === 'Noche' ? 'selected' : '' %>>Noche</option>
              </select>
            </div>
          </div>
        </section>

        <section class="form-section">
          <h2>Licencia Provincial</h2>
          <div class="form-row">
            <div class="form-group"><label>Número de Licencia</label><input name="numero_licencia" type="text" value="<%= chofer.licencia.numero %>"></div>
            <div class="form-group">
              <label>Categoría de Licencia</label>
              <select name="categoria">
                <% ['A','B1','B2','C','D','E','G'].forEach(function(cat) { %>
                  <option value="<%= cat %>" <%= chofer.licencia.categoria === cat ? 'selected' : '' %>><%= cat %></option>
                <% }) %>
              </select>
            </div>
          </div>
          <div class="form-notice is-success">
            <span>Vencimiento: 31/12 (<%= chofer.licencia.fechaVencimiento %>) · <%= chofer.licencia.estadoLabel %>. Para renovarla, usá el botón "Renovar Licencia" en la ficha del chofer — se calcula automáticamente según la fecha de retiro.</span>
          </div>
        </section>

        <section class="form-section">
          <h2>Licencia Nacional</h2>
          <div class="form-row">
            <div class="form-group"><label>Número de Licencia</label><input name="numero_licencia_nacional" type="text" value="<%= chofer.licenciaNacional ? chofer.licenciaNacional.numero : '' %>"></div>
            <div class="form-group">
              <label>Categoría</label>
              <select name="categoria_nacional">
                <option value="">Seleccionar</option>
                <% ['A','B1','B2','C','D','E','G'].forEach(function(cat) { %>
                  <option value="<%= cat %>" <%= chofer.licenciaNacional && chofer.licenciaNacional.categoria === cat ? 'selected' : '' %>><%= cat %></option>
                <% }) %>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group"><label>Fecha de Emisión</label><input name="fecha_emision_nacional" type="date"></div>
            <div class="form-group"><label>Fecha de Vencimiento</label><input name="fecha_vencimiento_nacional" type="date" value="<%= chofer.licenciaNacional ? chofer.licenciaNacional.vencimientoISO : '' %>"></div>
          </div>
          <% if (chofer.licenciaNacional && chofer.licenciaNacional.estadoLabel) { %>
            <div class="form-notice <%= chofer.licenciaNacional.estadoClase === 'danger' ? 'is-error' : 'is-success' %>">
              <span>Estado actual: <%= chofer.licenciaNacional.estadoLabel %> · vence el <%= chofer.licenciaNacional.fechaVencimiento %>.</span>
            </div>
          <% } %>
        </section>

        <section class="form-section">
          <h2>Documentación <span class="tag-muted">(foto o fotocopia — subí sólo lo que quieras reemplazar)</span></h2>

          <p class="field-hint">DNI</p>
          <div class="form-row">
            <div class="form-group">
              <div class="upload-box"><label for="dni_frente">Frente</label><input type="file" id="dni_frente" name="dni_frente" accept="image/*,.pdf"></div>
              <% if (chofer.documentos.dniFrente) { %><a href="<%= chofer.documentos.dniFrente %>" target="_blank" class="field-hint">Ver archivo actual</a><% } %>
            </div>
            <div class="form-group">
              <div class="upload-box"><label for="dni_dorso">Dorso</label><input type="file" id="dni_dorso" name="dni_dorso" accept="image/*,.pdf"></div>
              <% if (chofer.documentos.dniDorso) { %><a href="<%= chofer.documentos.dniDorso %>" target="_blank" class="field-hint">Ver archivo actual</a><% } %>
            </div>
          </div>

          <p class="field-hint" style="margin-top:var(--space-4)">Licencia Provincial</p>
          <div class="form-row">
            <div class="form-group">
              <div class="upload-box"><label for="lic_prov_frente">Frente</label><input type="file" id="lic_prov_frente" name="licencia_provincial_frente" accept="image/*,.pdf"></div>
              <% if (chofer.documentos.licenciaProvincialFrente) { %><a href="<%= chofer.documentos.licenciaProvincialFrente %>" target="_blank" class="field-hint">Ver archivo actual</a><% } %>
            </div>
            <div class="form-group">
              <div class="upload-box"><label for="lic_prov_dorso">Dorso</label><input type="file" id="lic_prov_dorso" name="licencia_provincial_dorso" accept="image/*,.pdf"></div>
              <% if (chofer.documentos.licenciaProvincialDorso) { %><a href="<%= chofer.documentos.licenciaProvincialDorso %>" target="_blank" class="field-hint">Ver archivo actual</a><% } %>
            </div>
          </div>

          <p class="field-hint" style="margin-top:var(--space-4)">Licencia Nacional</p>
          <div class="form-row">
            <div class="form-group">
              <div class="upload-box"><label for="lic_nac_frente">Frente</label><input type="file" id="lic_nac_frente" name="licencia_nacional_frente" accept="image/*,.pdf"></div>
              <% if (chofer.documentos.licenciaNacionalFrente) { %><a href="<%= chofer.documentos.licenciaNacionalFrente %>" target="_blank" class="field-hint">Ver archivo actual</a><% } %>
            </div>
            <div class="form-group">
              <div class="upload-box"><label for="lic_nac_dorso">Dorso</label><input type="file" id="lic_nac_dorso" name="licencia_nacional_dorso" accept="image/*,.pdf"></div>
              <% if (chofer.documentos.licenciaNacionalDorso) { %><a href="<%= chofer.documentos.licenciaNacionalDorso %>" target="_blank" class="field-hint">Ver archivo actual</a><% } %>
            </div>
          </div>
        </section>

        <section class="form-section">
          <h2>Imagen de Perfil <span class="tag-muted">(opcional al editar)</span></h2>
          <div class="upload-box">
            <label for="imagen">Subir nueva imagen (reemplaza la actual)</label>
            <input type="file" id="imagen" name="imagen" accept="image/*">
          </div>
          <p class="field-hint" style="margin-top:var(--space-2)">Si no subís un archivo nuevo, se mantiene la imagen guardada.</p>
        </section>

        <div class="form-actions">
          <a href="/choferes/<%= chofer.id %>" class="btn btn-outline">Cancelar</a>
          <button type="submit" class="btn btn-accent">Actualizar Chofer</button>
        </div>
      </form>
    </div>
  </main>
</div>

<script src="/js/pages/choferes-editar.js"></script>
<%- include('../partials/scripts') %>
