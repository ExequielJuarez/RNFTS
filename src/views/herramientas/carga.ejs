<%- include('../partials/head', { titulo: 'Cargar Herramienta', estilosPagina: ['/css/forms.css'] }) %>

<div class="app-shell" id="appShell">
  <%- include('../partials/topbar', { usuario: usuario, notificaciones: notificaciones }) %>
  <%- include('../partials/sidebar', { activeModulo: 'herramientas' }) %>

  <main class="app-main" style="overflow-y:auto">
    <div class="form-page">

      <a href="/herramientas" class="btn btn-sm btn-ghost btn-page-back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        Volver a Inventario
      </a>

      <div class="form-page-header">
        <div>
          <h1>Cargar Herramienta</h1>
          <p>Registrá un nuevo activo físico en el inventario.</p>
        </div>
      </div>

      <form action="/herramientas/nueva" method="post">
        <section class="form-section">
          <h2>Información Básica</h2>
          <div class="form-group"><label>Código de Activo / ID <span class="req">*</span></label><input name="codigo_activo" type="text" placeholder="Ej: HTI-001" required></div>
          <div class="form-row">
            <div class="form-group"><label>Nombre de Herramienta / Modelo <span class="req">*</span></label><input name="nombre" type="text" placeholder="Ej: Taladro Percutor Bosch" required></div>
            <div class="form-group">
              <label>Sector Destino <span class="req">*</span></label>
              <select name="sector" required>
                <option value="">Seleccione sector</option>
                <% sectores.forEach(function (s) { %><option value="<%= s %>"><%= s %></option><% }) %>
              </select>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group"><label>Cantidad (Stock Físico) <span class="req">*</span></label><input name="stock" type="number" min="0" placeholder="Ej: 5" required></div>
            <div class="form-group"><label>Fecha de Ingreso</label><input name="fecha_alta" type="date"></div>
          </div>
        </section>

        <section class="form-section">
          <h2>Estado y Observaciones</h2>
          <div class="form-row">
            <div class="form-group">
              <label>Estado Inicial</label>
              <select name="estado">
                <option value="Disponible">Disponible</option>
                <option value="En Reparación">En Reparación</option>
                <option value="Baja">Baja</option>
              </select>
            </div>
            <div class="form-group"><label>Combustible / Energía <span class="tag-muted">(opcional)</span></label><input name="combustible_energia" type="text" placeholder="Ej: Batería 80% o Nafta"></div>
          </div>
          <div class="form-group"><label>Observaciones Adicionales</label><textarea name="observaciones" placeholder="Detallá cualquier particularidad del ingreso..."></textarea></div>
        </section>

        <div class="form-actions">
          <a href="/herramientas" class="btn btn-outline">Cancelar</a>
          <button type="submit" class="btn btn-accent">Guardar Herramienta</button>
        </div>
      </form>
    </div>
  </main>
</div>

<%- include('../partials/scripts') %>
