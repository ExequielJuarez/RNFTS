<%- include('../partials/head', { titulo: 'Siniestros y Seguros', hojaEstilo: 'siniestros-listado' }) %>

<div class="app-shell" id="appShell">
  <%- include('../partials/topbar', { usuario: usuario, notificaciones: notificaciones }) %>
  <%- include('../partials/sidebar', { activeModulo: 'siniestros' }) %>

  <main class="app-main" style="overflow-y:auto">
    <div class="page-wrap">

      <div class="page-header-row">
        <div>
          <h1>Siniestros y Seguros</h1>
          <p>Panel de control y seguimiento de accidentes de la flota.</p>
        </div>
        <div class="page-header-actions">
          <button class="btn btn-outline" id="btn-exportar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
            Exportar CSV
          </button>
          <a href="/siniestros/nuevo" class="btn" style="background:var(--danger); color:#fff;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            Registrar Siniestro
          </a>
        </div>
      </div>

      <div class="card">
        <div class="card-body filter-bar">
          <div class="form-group"><label>Buscar Patente / Chofer</label><input type="text" id="filtro-texto" placeholder="Escribí para filtrar..."></div>
          <div class="form-group">
            <label>Estado del Trámite</label>
            <select id="filtro-estado">
              <option value="">Todos</option>
              <option value="EN PROCESO">En Proceso</option>
              <option value="RESUELTO">Resuelto</option>
            </select>
          </div>
          <div class="form-group"><label>Mes del Hecho</label><input type="month" id="filtro-mes"></div>
        </div>
      </div>

      <div class="card">
        <div class="table-scroll">
          <table class="table" id="tabla-siniestros" style="min-width:760px">
            <thead>
              <tr><th>Fecha</th><th>Vehículo Propio</th><th>Chofer Asignado</th><th>Tercero / Seguro</th><th>Estado</th><th>Acciones</th></tr>
            </thead>
            <tbody>
              <% if (siniestros.length) { %>
                <% siniestros.forEach(function (s) { %>
                  <tr class="fila-siniestro" data-fecha="<%= s.fecha %>" data-estado="<%= s.estado %>">
                    <td class="is-primary"><%= new Date(s.fecha).toLocaleDateString('es-AR') %></td>
                    <td>
                      <span class="is-primary" style="display:block; color:var(--accent)"><%= s.patente %></span>
                      <span style="font-size:12px; color:var(--text-muted)"><%= s.vehiculoMarca %></span>
                    </td>
                    <td><%= s.choferNombre || 'No indicado' %></td>
                    <td>
                      <span style="display:block; font-weight:600;"><%= s.tercero ? s.tercero.vehiculo : 'Sin terceros' %></span>
                      <span style="font-size:12px; color:var(--text-muted)"><%= s.tercero ? s.tercero.seguro : '-' %></span>
                    </td>
                    <td><span class="badge badge-<%= s.estado === 'RESUELTO' ? 'success' : 'warning' %>"><%= s.estado === 'RESUELTO' ? 'Resuelto' : 'En Proceso' %></span></td>
                    <td>
                      <div style="display:flex; gap:var(--space-2)">
                        <a href="/siniestros/<%= s.id %>" class="btn btn-sm btn-outline">Ver / Editar</a>
                        <% if (s.estado !== 'RESUELTO') { %>
                          <form action="/siniestros/<%= s.id %>/resolver" method="post" onsubmit="return confirm('¿Marcar este siniestro como Resuelto?')">
                            <button type="submit" class="btn btn-sm btn-outline" style="color:var(--success); border-color:var(--success-border);">Cerrar Caso</button>
                          </form>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="6" class="table-empty">No hay siniestros registrados en el sistema.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>

<script src="/js/pages/siniestros-listado.js"></script>
<%- include('../partials/scripts') %>
