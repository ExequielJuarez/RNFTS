<%- include('../partials/head', { titulo: 'Panel de Alertas', hojaEstilo: 'alertas-listado' }) %>

<div class="app-shell" id="appShell">
  <%- include('../partials/topbar', { usuario: usuario, notificaciones: notificaciones }) %>
  <%- include('../partials/sidebar', { activeModulo: 'alertas' }) %>

  <main class="app-main" style="overflow-y:auto">
    <div class="page-wrap">

      <div class="page-header-row">
        <div>
          <h1>Alertas y Estado Operacional</h1>
          <p>Control y seguimiento de notificaciones automáticas del sistema.</p>
        </div>
      </div>

      <div class="stat-grid">
        <button class="stat-card" data-filtro-tipo="licencia_vencida">
          <span class="stat-card-label">Licencias Vencidas</span>
          <span class="stat-card-value" style="color:var(--danger)"><%= resumen.licVencidas %></span>
        </button>
        <button class="stat-card" data-filtro-tipo="licencia_proxima">
          <span class="stat-card-label">Próximas a vencer</span>
          <span class="stat-card-value" style="color:var(--warning)"><%= resumen.licProximas %></span>
        </button>
        <button class="stat-card" data-filtro-tipo="documentacion_vencida">
          <span class="stat-card-label">Docs. Vencida (RTO/Seg)</span>
          <span class="stat-card-value" style="color:var(--danger)"><%= resumen.docsVencidas %></span>
        </button>
        <button class="stat-card" data-filtro-tipo="mantenimiento_proximo">
          <span class="stat-card-label">Mantenimiento Próximo</span>
          <span class="stat-card-value" style="color:var(--warning)"><%= resumen.mantProximos %></span>
        </button>
      </div>

      <%
        const vehTotal = estadisticas.vehiculos.disponible + estadisticas.vehiculos.uso + estadisticas.vehiculos.baja;
        const chofTotal = estadisticas.choferes.activo + estadisticas.choferes.inactivo;
      %>
      <div class="chart-grid">
        <div class="card">
          <div class="card-header"><span class="card-title">Estado General de Vehículos</span></div>
          <div class="card-body donut-row">
            <div class="donut" id="donutVehiculos" data-values="<%= estadisticas.vehiculos.disponible %>,<%= estadisticas.vehiculos.uso %>,<%= estadisticas.vehiculos.baja %>" data-colors="var(--success),var(--info),var(--danger)">
              <div class="donut-total"><strong><%= vehTotal %></strong><span>Total</span></div>
            </div>
            <div class="donut-legend">
              <div class="donut-legend-item"><span class="donut-legend-dot" style="background:var(--success)"></span>Disponibles<span class="donut-legend-value"><%= estadisticas.vehiculos.disponible %></span></div>
              <div class="donut-legend-item"><span class="donut-legend-dot" style="background:var(--info)"></span>En Uso<span class="donut-legend-value"><%= estadisticas.vehiculos.uso %></span></div>
              <div class="donut-legend-item"><span class="donut-legend-dot" style="background:var(--danger)"></span>Baja<span class="donut-legend-value"><%= estadisticas.vehiculos.baja %></span></div>
            </div>
          </div>
        </div>
        <div class="card">
          <div class="card-header"><span class="card-title">Disponibilidad de Choferes</span></div>
          <div class="card-body donut-row">
            <div class="donut" id="donutChoferes" data-values="<%= estadisticas.choferes.activo %>,<%= estadisticas.choferes.inactivo %>" data-colors="var(--accent),var(--neutral)">
              <div class="donut-total"><strong><%= chofTotal %></strong><span>Total</span></div>
            </div>
            <div class="donut-legend">
              <div class="donut-legend-item"><span class="donut-legend-dot" style="background:var(--accent)"></span>Activos<span class="donut-legend-value"><%= estadisticas.choferes.activo %></span></div>
              <div class="donut-legend-item"><span class="donut-legend-dot" style="background:var(--neutral)"></span>Inactivos<span class="donut-legend-value"><%= estadisticas.choferes.inactivo %></span></div>
            </div>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-body filter-bar" style="align-items:flex-end">
          <div class="form-group" style="grid-column:span 2"><label>Buscar</label><input type="search" id="filtro-buscar" placeholder="Chofer, vehículo..."></div>
          <div class="form-group"><label>Fecha desde</label><input type="date" id="filtro-desde"></div>
          <div class="form-group"><label>Fecha hasta</label><input type="date" id="filtro-hasta"></div>
          <div class="form-group">
            <label>Tipo de alerta</label>
            <select id="filtro-tipo">
              <option value="">Todos</option>
              <option value="licencia_vencida">Licencia vencida</option>
              <option value="licencia_proxima">Licencia próxima</option>
              <option value="documentacion_vencida">Documentación vencida</option>
              <option value="mantenimiento_proximo">Mantenimiento próximo</option>
              <option value="siniestro_activo">Siniestro activo</option>
              <option value="vehiculo_fuera_servicio">Fuera de servicio</option>
            </select>
          </div>
          <div class="form-group">
            <label>Estado</label>
            <select id="filtro-estado">
              <option value="">Todas</option>
              <option value="no_leida">No leídas</option>
              <option value="leida">Leídas</option>
            </select>
          </div>
          <button type="button" id="btn-limpiar" class="btn btn-outline">Limpiar</button>
        </div>
      </div>

      <div class="card">
        <div class="table-scroll">
          <table class="table" style="min-width:820px">
            <thead><tr><th>Tipo</th><th>Descripción</th><th>Entidad</th><th>Fecha</th><th>Prioridad</th><th>Estado</th><th></th></tr></thead>
            <tbody id="alertas-tbody">
              <% alertas.forEach(function (a) { %>
                <tr class="alerta-row"
                  data-tipo="<%= a.tipo %>"
                  data-estado="<%= a.leida ? 'leida' : 'no_leida' %>"
                  data-fecha="<%= a.fecha.slice(0, 10) %>"
                  data-buscar="<%= (a.mensaje + ' ' + a.entidadNombre).toLowerCase() %>"
                  style="<%= a.leida ? 'opacity:.65' : '' %>">
                  <td class="is-primary"><%= a.label %></td>
                  <td style="max-width:280px"><%= a.mensaje %></td>
                  <td><span class="badge badge-neutral"><%= a.entidadNombre %></span></td>
                  <td><%= new Date(a.fecha).toLocaleDateString('es-AR') %></td>
                  <td><span class="badge badge-<%= a.prioridad === 'alta' ? 'danger' : (a.prioridad === 'media' ? 'warning' : 'info') %>"><%= a.prioridad %></span></td>
                  <td><span class="badge badge-<%= a.leida ? 'success' : 'warning' %>"><%= a.leida ? 'Leída' : 'Nueva' %></span></td>
                  <td>
                    <div style="display:flex; gap:var(--space-2); justify-content:flex-end">
                      <% if (!a.leida) { %><button class="btn btn-sm btn-outline btn-marcar-leida" data-id="<%= a.id %>">✓ Leída</button><% } %>
                      <a href="/alertas/<%= a.id %>" class="btn btn-sm btn-outline">Abrir</a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          <p class="table-empty" id="sin-resultados" style="display:none">No hay alertas que coincidan con los filtros aplicados.</p>
        </div>
      </div>
    </div>
  </main>
</div>

<script src="/js/pages/alertas-listado.js"></script>
<%- include('../partials/scripts') %>
