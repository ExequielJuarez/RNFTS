<%- include('../partials/head', { titulo: 'Log de Auditoría' }) %>

<div class="app-shell" id="appShell">
  <%- include('../partials/topbar', { usuario: usuario, notificaciones: notificaciones }) %>
  <%- include('../partials/sidebar', { activeModulo: 'auditoria' }) %>

  <main class="app-main" style="overflow-y:auto">
    <div class="page-wrap">

      <div class="page-header-row">
        <div>
          <h1>Log de Auditoría</h1>
          <p>Registro de movimientos, creaciones y bajas realizadas por los usuarios.</p>
        </div>
      </div>

      <div class="card">
        <div class="card-header"><span class="card-title">Resumen de Acciones</span></div>
        <div class="card-body donut-row">
          <div class="donut" data-values="<%= resumen.map(function(r){return r.cantidad}).join(',') %>" data-colors="<%= resumen.map(function(r){return r.color}).join(',') %>">
            <div class="donut-total"><strong><%= registros.length %></strong><span>Total</span></div>
          </div>
          <div class="donut-legend">
            <% resumen.forEach(function (r) { %>
              <div class="donut-legend-item"><span class="donut-legend-dot" style="background:<%= r.color %>"></span><%= r.accion %><span class="donut-legend-value"><%= r.cantidad %></span></div>
            <% }) %>
          </div>
        </div>
      </div>

      <div class="card">
        <div class="card-body filter-bar">
          <div class="form-group" style="grid-column:span 2"><label>Búsqueda rápida</label><input type="search" id="filtro-buscar" placeholder="Usuario, módulo, detalle..."></div>
          <div class="form-group"><label>Desde</label><input type="date" id="filtro-desde"></div>
          <div class="form-group"><label>Hasta</label><input type="date" id="filtro-hasta"></div>
        </div>
      </div>

      <p style="font-size:12.5px; color:var(--text-muted); font-weight:600" id="contador"><%= registros.length %> registros.</p>

      <div class="card">
        <div class="table-scroll">
          <table class="table" style="min-width:760px">
            <thead><tr><th>Fecha y Hora</th><th>Usuario</th><th>Módulo</th><th>Acción</th><th>Detalle</th></tr></thead>
            <tbody id="tabla-body">
              <% registros.forEach(function (r) { %>
                <tr class="fila-registro" data-fecha="<%= r.fecha.slice(0, 10) %>" data-buscar="<%= (r.usuario + ' ' + r.tabla + ' ' + r.detalle).toLowerCase() %>">
                  <td class="is-primary" style="white-space:nowrap">
                    <%= new Date(r.fecha).toLocaleDateString('es-AR') %>
                    <div style="font-weight:400; font-size:12px; color:var(--text-muted)"><%= new Date(r.fecha).toLocaleTimeString('es-AR', {hour:'2-digit', minute:'2-digit'}) %></div>
                  </td>
                  <td style="color:var(--accent); font-weight:600"><%= r.usuario %></td>
                  <td><%= r.tabla %></td>
                  <td><span class="badge badge-<%= r.badge %>"><%= r.accion %></span></td>
                  <td style="max-width:340px"><%= r.detalle %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>

<%- include('../partials/scripts') %>
<script>
  document.querySelectorAll('.donut').forEach(function (donut) {
    var values = donut.dataset.values.split(',').map(Number);
    var colors = donut.dataset.colors.split(',');
    var total = values.reduce(function (a, b) { return a + b; }, 0) || 1;
    var acc = 0;
    var stops = values.map(function (v, i) {
      var start = (acc / total) * 360;
      acc += v;
      var end = (acc / total) * 360;
      return colors[i] + ' ' + start + 'deg ' + end + 'deg';
    });
    donut.style.background = 'conic-gradient(' + stops.join(', ') + ')';
  });

  var filas = Array.from(document.querySelectorAll('.fila-registro'));
  var filtroBuscar = document.getElementById('filtro-buscar');
  var filtroDesde = document.getElementById('filtro-desde');
  var filtroHasta = document.getElementById('filtro-hasta');
  var contador = document.getElementById('contador');

  function filtrar() {
    var b = filtroBuscar.value.toLowerCase();
    var visibles = 0;
    filas.forEach(function (fila) {
      var ok = true;
      if (b && !fila.dataset.buscar.includes(b)) ok = false;
      if (filtroDesde.value && fila.dataset.fecha < filtroDesde.value) ok = false;
      if (filtroHasta.value && fila.dataset.fecha > filtroHasta.value) ok = false;
      fila.style.display = ok ? '' : 'none';
      if (ok) visibles++;
    });
    contador.textContent = visibles + ' registro' + (visibles === 1 ? '' : 's') + '.';
  }
  [filtroBuscar, filtroDesde, filtroHasta].forEach(function (el) { el.addEventListener('input', filtrar); });
</script>
