<header class="app-topbar">
  <button class="btn btn-icon btn-ghost btn-hamburger" id="btnHamburger" aria-label="Abrir menú" aria-expanded="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
  </button>

  <div class="topbar-brand">
    <span class="brand-mark">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 16.5V8.8c0-.6.4-1.1 1-1.3l7-2.3c.3-.1.7-.1 1 0l7 2.3c.6.2 1 .7 1 1.3v7.7"/>
        <path d="M3 16.5h18M6 16.5V12m12 4.5V12M9.5 16.5V12h5v4.5"/>
        <circle cx="6" cy="19" r="1.6"/><circle cx="18" cy="19" r="1.6"/>
      </svg>
    </span>
    <span class="brand-text">
      <strong>Ficha Técnica</strong>
      <span>MUNICIPALIDAD</span>
    </span>
  </div>

  <div class="topbar-spacer"></div>

  <div class="topbar-actions">
    <button class="btn-bell" aria-label="Notificaciones">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
      <span class="bell-count"><%= typeof notificaciones !== 'undefined' ? notificaciones : 0 %></span>
    </button>

    <div class="topbar-user">
      <span class="user-avatar"><%= (typeof usuario !== 'undefined' ? usuario.iniciales : 'AS') %></span>
      <span class="user-meta">
        <strong><%= typeof usuario !== 'undefined' ? usuario.nombre : 'Administrador Sistema' %></strong>
        <span><%= typeof usuario !== 'undefined' ? usuario.rol : 'ADMINISTRADOR' %></span>
      </span>
      <button class="btn btn-sm btn-outline btn-logout">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
        Salir
      </button>
    </div>
  </div>
</header>
