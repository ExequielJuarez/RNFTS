<%- include('../partials/head', { titulo: 'Programar Turno de Service', hojaEstilo: 'mantenimientos-turno-nuevo' }) %>

<div class="app-shell" id="appShell">
  <%- include('../partials/topbar', { usuario: usuario, notificaciones: notificaciones }) %>
  <%- include('../partials/sidebar', { activeModulo: 'mantenimientos', activeItem: activeItem }) %>

  <main class="app-main" style="overflow-y:auto">
    <div class="form-page">

      <a href="/mantenimientos/turnos" class="btn btn-sm btn-ghost btn-page-back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        Volver a Turnos de Service
      </a>

      <div class="form-page-header">
        <div>
          <h1>Programar Turno de Service</h1>
          <p>Mientras el turno esté "Programado", el vehículo queda bloqueado para viajes de comisión dentro de los 14 días cercanos a la fecha.</p>
        </div>
      </div>

      <form action="/mantenimientos/turnos/nuevo" method="post">
        <section class="form-section">
          <h2>Datos del Turno</h2>
          <div class="form-row">
            <div class="form-group">
              <label>Vehículo <span class="req">*</span></label>
              <select name="vehiculo" required>
                <option value="">Seleccione un vehículo</option>
                <% vehiculos.forEach(function (v) { %>
                  <option value="<%= v.patente %>"><%= v.patente %> - <%= v.marca %> <%= v.modelo %></option>
                <% }) %>
              </select>
            </div>
            <div class="form-group"><label>Fecha Programada <span class="req">*</span></label><input type="date" name="fecha_programada" required></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label>Tipo de Servicio <span class="req">*</span></label><input type="text" name="tipo_servicio" placeholder="Ej: Service de 50.000 km" required></div>
            <div class="form-group"><label>Taller</label><input type="text" name="taller" placeholder="Ej: Taller Central"></div>
          </div>
          <div class="form-group"><label>Observaciones</label><textarea name="observaciones" placeholder="Notas sobre el turno..."></textarea></div>
        </section>

        <div class="form-actions">
          <a href="/mantenimientos/turnos" class="btn btn-outline">Cancelar</a>
          <button type="submit" class="btn btn-accent">Programar Turno</button>
        </div>
      </form>
    </div>
  </main>
</div>

<script src="/js/pages/mantenimientos-turno-nuevo.js"></script>
<%- include('../partials/scripts') %>
