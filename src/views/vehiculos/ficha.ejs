<%- include('../partials/head', { titulo: vehiculo.patente, estilosPagina: ['/css/vehiculo-ficha.css'] }) %>

<div class="app-shell" id="appShell">
  <%- include('../partials/topbar', { usuario: usuario, notificaciones: notificaciones }) %>
  <%- include('../partials/sidebar', { activeModulo: 'vehiculos', activeItem: 'inventario' }) %>

  <main class="app-main">
    <div class="master-detail <%= mostrarDetalle ? 'showing-detail' : '' %>" id="masterDetail">

      <!-- ===================== LISTADO ===================== -->
      <section class="md-list">
        <div class="list-header">
          <h1>Listado de Vehículos</h1>
          <label class="input-search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
            <input type="search" placeholder="Buscar por patente..." aria-label="Buscar por patente" />
          </label>
        </div>

        <div class="vehicle-list scrollbar-thin">
          <% vehiculos.forEach(function (v) { %>
            <a
              href="/vehiculos/<%= v.patente %>"
              class="vehicle-card <%= v.patente === vehiculo.patente ? 'is-active' : '' %>"
              data-open-detail
            >
              <span class="vehicle-thumb">
                <% if (v.foto) { %>
                  <img src="<%= v.foto %>" alt="" />
                <% } else { %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 16.5V8.8c0-.6.4-1.1 1-1.3l7-2.3c.3-.1.7-.1 1 0l7 2.3c.6.2 1 .7 1 1.3v7.7"/><path d="M3 16.5h18M6 16.5V12m12 4.5V12M9.5 16.5V12h5v4.5"/></svg>
                <% } %>
              </span>
              <span class="vehicle-card-body">
                <span class="vehicle-card-top">
                  <span class="vehicle-plate"><%= v.patente %></span>
                  <span class="vehicle-km"><%= v.km.toLocaleString('es-AR') %> km</span>
                </span>
                <span class="vehicle-model"><%= v.marca %> · <%= v.modelo %></span>
                <span class="badge badge-<%= v.estadoClase %>"><%= v.estadoLabel %></span>
              </span>
            </a>
          <% }) %>
        </div>
      </section>

      <!-- ===================== DETALLE ===================== -->
      <section class="md-detail">
        <div class="detail-wrap">

          <button class="btn btn-sm btn-ghost btn-back-list" data-back-to-list style="align-self:flex-start">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
            Volver al listado
          </button>

          <!-- Hero: foto + datos principales + acciones -->
          <div class="card detail-hero">
            <div class="hero-top">
              <div class="hero-photo">
                <% if (vehiculo.foto) { %>
                  <img src="<%= vehiculo.foto %>" alt="Foto de <%= vehiculo.marca %> <%= vehiculo.modelo %>, patente <%= vehiculo.patente %>" />
                <% } else { %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 16.5V8.8c0-.6.4-1.1 1-1.3l7-2.3c.3-.1.7-.1 1 0l7 2.3c.6.2 1 .7 1 1.3v7.7"/><path d="M3 16.5h18M6 16.5V12m12 4.5V12M9.5 16.5V12h5v4.5"/></svg>
                <% } %>
                <button class="btn-photo" type="button" title="Cambiar foto" aria-label="Cambiar foto del vehículo">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h3l2-2h6l2 2h3v12H4z"/><circle cx="12" cy="13" r="3.5"/></svg>
                </button>
              </div>

              <div class="hero-info">
                <div class="hero-plate-row">
                  <span class="hero-plate"><%= vehiculo.patente %></span>
                  <span class="badge badge-<%= vehiculo.estadoClase %>"><%= vehiculo.estadoLabel %></span>
                </div>
                <p class="hero-subtitle"><%= vehiculo.marca %> <%= vehiculo.modelo %> · <%= vehiculo.anio %></p>
                <div class="hero-tags">
                  <span class="hero-tag">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-4.5 7-11a7 7 0 1 0-14 0c0 6.5 7 11 7 11z"/><circle cx="12" cy="11" r="2.5"/></svg>
                    <%= vehiculo.distrito %>
                  </span>
                  <span class="hero-tag">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="10" cy="7" r="4"/></svg>
                    <% if (vehiculo.choferAsignado) { %>
                      <a href="/choferes/<%= vehiculo.choferId %>" style="color:var(--accent);font-weight:600"><%= vehiculo.choferAsignado %></a>
                    <% } else { %>
                      Sin chofer asignado
                    <% } %>
                  </span>
                  <span class="hero-tag">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    <%= vehiculo.km.toLocaleString('es-AR') %> km actuales
                  </span>
                </div>
              </div>

              <div class="hero-actions">
                <button class="btn btn-sm btn-outline">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
                  Exportar CSV
                </button>
                <a href="/vehiculos/<%= vehiculo.patente %>/cedula" class="btn btn-sm btn-outline">Ver Cédula</a>
              </div>
            </div>

            <div class="hero-toolbar">
              <button class="btn btn-sm btn-outline">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9V3h12v6"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v7H6z"/></svg>
                Imprimir
              </button>
              <a href="/vehiculos/<%= vehiculo.patente %>/editar" class="btn btn-sm btn-outline">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                Editar
              </a>
              <span class="spacer"></span>
              <a href="/mantenimientos/nuevo?patente=<%= vehiculo.patente %>" class="btn btn-sm btn-accent">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                Mantenimiento
              </a>
            </div>
          </div>

          <!-- Ficha técnica -->
          <div class="card">
            <div class="card-header">
              <span class="card-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M8 4v16"/></svg>
                Ficha Técnica
              </span>
            </div>
            <div class="card-body">
              <div class="info-grid">
                <div><span class="field-label">Marca / Modelo</span><span class="field-value"><%= vehiculo.marca %> <%= vehiculo.modelo %></span></div>
                <div><span class="field-label">Chasis</span><span class="field-value"><%= vehiculo.chasis %></span></div>
                <div><span class="field-label">Distrito</span><span class="field-value"><%= vehiculo.distrito %></span></div>
                <div><span class="field-label">Tipo</span><span class="field-value"><%= vehiculo.tipo %></span></div>
                <div><span class="field-label">Motor</span><span class="field-value"><%= vehiculo.motor %></span></div>
                <div><span class="field-label">Fecha de Alta</span><span class="field-value"><%= vehiculo.fechaAlta %></span></div>
                <div><span class="field-label">Año</span><span class="field-value"><%= vehiculo.anio %></span></div>
                <div><span class="field-label">Transmisión</span><span class="field-value"><%= vehiculo.transmision %></span></div>
                <div><span class="field-label">Chofer Asignado</span><span class="field-value">
                  <% if (vehiculo.choferAsignado) { %><a href="/choferes/<%= vehiculo.choferId %>"><%= vehiculo.choferAsignado %></a><% } else { %>—<% } %>
                </span></div>
                <div><span class="field-label">Km Actual</span><span class="field-value"><%= vehiculo.km.toLocaleString('es-AR') %> km</span></div>
                <div><span class="field-label">Combustible</span><span class="field-value"><%= vehiculo.combustible %></span></div>
              </div>
            </div>
          </div>

          <!-- Documentación y coberturas -->
          <div class="card">
            <div class="card-header">
              <span class="card-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6l5 5v10a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M9 13h6M9 17h4"/></svg>
                Documentación y Coberturas
              </span>
            </div>
            <div class="card-body">
              <div class="info-grid">
                <div><span class="field-label">Cédula</span><span class="field-value"><%= vehiculo.documentacion.cedula %></span></div>
                <div><span class="field-label">Titular</span><span class="field-value"><%= vehiculo.documentacion.titular %></span></div>
                <div><span class="field-label">Seguro</span><span class="field-value"><%= vehiculo.documentacion.seguroCompania %></span></div>
                <div><span class="field-label">Venc. Seguro</span><span class="field-value"><%= vehiculo.documentacion.vencSeguro %></span></div>
                <div>
                  <span class="field-label">Venc. RTO</span>
                  <span class="field-value" style="<%= vehiculo.documentacion.rtoVencida ? 'color:var(--danger)' : '' %>">
                    <%= vehiculo.documentacion.vencRTO %>
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- Comodato -->
          <div class="card">
            <div class="card-header">
              <span class="card-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 12l2.5 2.5L16 9"/><rect x="3" y="4" width="18" height="16" rx="2"/></svg>
                Comodato
              </span>
              <span class="comodato-status">
                <% if (vehiculo.comodato) { %>
                  <span class="badge badge-<%= vehiculo.comodato.estadoClase %>"><%= vehiculo.comodato.estadoLabel %></span>
                <% } %>
                <button class="btn btn-sm btn-outline">
                  <% if (vehiculo.comodato) { %>Editar Comodato<% } else { %>+ Agregar Comodato<% } %>
                </button>
              </span>
            </div>
            <div class="card-body">
              <% if (vehiculo.comodato) { %>
                <div class="comodato-summary">
                  <div><span class="field-label">Comodatario</span><span class="field-value"><%= vehiculo.comodato.comodatario %></span></div>
                  <div><span class="field-label">Tipo</span><span class="field-value"><%= vehiculo.comodato.tipo %></span></div>
                  <div><span class="field-label">N° de Convenio</span><span class="field-value"><%= vehiculo.comodato.numero %></span></div>
                  <div><span class="field-label">Fecha de Inicio</span><span class="field-value"><%= vehiculo.comodato.fechaInicio %></span></div>
                  <div><span class="field-label">Fecha de Finalización</span><span class="field-value"><%= vehiculo.comodato.fechaFin %></span></div>
                  <div><span class="field-label">Documento</span><span class="field-value"><a href="<%= vehiculo.comodato.documentoUrl %>">Ver PDF adjunto</a></span></div>
                </div>
                <% if (vehiculo.comodato.observaciones) { %>
                  <p class="comodato-note"><%= vehiculo.comodato.observaciones %></p>
                <% } %>
              <% } else { %>
                <div class="comodato-empty">
                  <div>
                    <strong>Este vehículo no tiene un comodato activo</strong>
                    <p>Registrá un convenio de comodato para llevar el control de a quién y por cuánto tiempo se cede el uso del vehículo.</p>
                  </div>
                  <button class="btn btn-sm btn-accent" style="flex-shrink:0">+ Agregar Comodato</button>
                </div>
              <% } %>
            </div>
          </div>

          <div class="detail-columns">
            <div class="stack">
              <!-- Mantenimientos recientes -->
              <div class="card">
                <div class="card-header">
                  <span class="card-title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 1-5.4 5.4L4 17l1 1 5.3-5.3a4 4 0 0 1 5.4-5.4z"/></svg>
                    Mantenimientos Recientes
                  </span>
                  <a href="/mantenimientos?patente=<%= vehiculo.patente %>" class="btn btn-sm btn-ghost">Ver todos</a>
                </div>
                <% if (vehiculo.mantenimientos.length) { %>
                  <table class="table">
                    <thead>
                      <tr><th>Fecha</th><th>Servicio</th><th>Costo</th></tr>
                    </thead>
                    <tbody>
                      <% vehiculo.mantenimientos.forEach(function (m) { %>
                        <tr>
                          <td class="is-primary"><%= m.fecha %></td>
                          <td><%= m.servicio %></td>
                          <td class="is-primary">$<%= m.costo.toLocaleString('es-AR', {minimumFractionDigits:2}) %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                <% } else { %>
                  <p class="table-empty">Sin mantenimientos registrados</p>
                <% } %>
              </div>

              <!-- Siniestros registrados -->
              <div class="card">
                <div class="card-header">
                  <span class="card-title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 4.5-3 7.5-8 9-5-1.5-8-4.5-8-9V6z"/><path d="M12 8v5M12 16h.01"/></svg>
                    Siniestros Registrados
                  </span>
                </div>
                <% if (vehiculo.siniestros.length) { %>
                  <table class="table">
                    <thead>
                      <tr><th>Fecha</th><th>Ubicación</th><th>Estado</th></tr>
                    </thead>
                    <tbody>
                      <% vehiculo.siniestros.forEach(function (s) { %>
                        <tr>
                          <td class="is-primary"><%= s.fecha %></td>
                          <td><%= s.ubicacion %></td>
                          <td><span class="badge badge-<%= s.estadoClase %>"><%= s.estadoLabel %></span></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                <% } else { %>
                  <p class="table-empty">Sin siniestros reportados</p>
                <% } %>
              </div>
            </div>

            <!-- Alertas -->
            <div class="card">
              <div class="card-header">
                <span class="card-title">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
                  Alertas
                </span>
              </div>
              <div class="card-body">
                <% if (vehiculo.alertas.length) { %>
                  <% vehiculo.alertas.forEach(function (a) { %>
                    <div class="alert-item is-<%= a.tipo %>">
                      <% if (a.tipo === 'danger') { %>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/></svg>
                      <% } else { %>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
                      <% } %>
                      <span>
                        <strong><%= a.titulo %></strong>
                        <span><%= a.detalle %></span>
                      </span>
                    </div>
                  <% }) %>
                <% } else { %>
                  <p class="table-empty">Sin alertas pendientes</p>
                <% } %>
              </div>
            </div>
          </div>

        </div>
      </section>
    </div>
  </main>
</div>

<%- include('../partials/scripts') %>
