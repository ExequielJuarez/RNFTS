<%- include('../partials/head', { titulo: 'Actualizar Kilometraje', hojaEstilo: 'vehiculos-kilometraje' }) %>

<div class="app-shell" id="appShell">
  <%- include('../partials/topbar', { usuario: usuario, notificaciones: notificaciones }) %>
  <%- include('../partials/sidebar', { activeModulo: 'vehiculos', activeItem: 'kilometraje' }) %>

  <main class="app-main" style="overflow-y:auto">
    <div class="form-page">

      <a href="/vehiculos" class="btn btn-sm btn-ghost btn-page-back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        Volver a Vehículos
      </a>

      <div class="form-page-header">
        <div>
          <h1>Actualizar Kilometraje</h1>
          <p>Registrá la lectura de odómetro de los vehículos en circulación.</p>
        </div>
      </div>

      <form action="/vehiculos/kilometraje" method="post" id="form-km">

        <section class="form-section">
          <h2>1. Seleccionar Vehículo</h2>
          <div class="form-group">
            <select name="patente" id="select-vehiculo" required>
              <option value="">— Elegir un vehículo —</option>
              <% vehiculos.forEach(function (v) { %>
                <option value="<%= v.patente %>" data-km="<%= v.km %>" data-chofer="<%= v.choferAsignado || 'Sin asignar' %>"><%= v.patente %> · <%= v.marca %> <%= v.modelo %></option>
              <% }) %>
            </select>
          </div>

          <div class="km-info-grid">
            <div class="km-info-box">
              <div class="km-info-box-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 16.5V8.8c0-.6.4-1.1 1-1.3l7-2.3c.3-.1.7-.1 1 0l7 2.3c.6.2 1 .7 1 1.3v7.7"/><path d="M3 16.5h18M6 16.5V12m12 4.5V12M9.5 16.5V12h5v4.5"/></svg>
              </div>
              <div><span class="field-label">Última lectura</span><span class="km-giant" id="km-actual-display">0 km</span></div>
            </div>
            <div class="km-info-box">
              <div class="km-info-box-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="10" cy="7" r="4"/></svg>
              </div>
              <div><span class="field-label">Chofer asignado</span><span class="field-value" id="chofer-display">Sin asignar</span></div>
            </div>
          </div>
        </section>

        <section class="form-section">
          <h2>2. Ingresar Nuevo Kilometraje</h2>
          <div class="form-row">
            <div class="form-group">
              <label>Nueva Lectura de Odómetro <span class="req">*</span></label>
              <input type="number" name="km_nuevo" id="km_nuevo" min="0" placeholder="Ej: 102500" required>
              <span class="field-hint" id="km-diff-hint"></span>
            </div>
            <div class="form-group"><label>Fecha de lectura <span class="req">*</span></label><input type="date" name="fecha_actualizacion" id="fecha_actualizacion" required></div>
          </div>
          <div class="form-group"><label>Observaciones <span class="tag-muted">(opcional)</span></label><input type="text" name="observaciones" placeholder="Ej: Control de rutina al llegar a planta..."></div>
        </section>

        <div class="form-actions">
          <a href="/vehiculos" class="btn btn-outline">Cancelar</a>
          <button type="submit" class="btn btn-accent">Actualizar y Guardar</button>
        </div>
      </form>

      <div class="card chart-card">
        <div class="card-body">
          <div class="chart-card-header">
            <div>
              <h3 style="font-size:15px; font-weight:700;">Evolución de Kilometraje</h3>
              <p style="font-size:13px; color:var(--text-secondary)">Seleccioná un vehículo para ver su gráfico histórico.</p>
            </div>
            <select id="select-historial">
              <option value="">— Elegir vehículo —</option>
              <% vehiculos.forEach(function (v) { %>
                <option value="<%= v.patente %>"><%= v.patente %> · <%= v.marca %> <%= v.modelo %></option>
              <% }) %>
            </select>
          </div>
          <div class="chart-canvas-wrap"><canvas id="kmChart"></canvas></div>
        </div>
      </div>
    </div>
  </main>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
  // Datos del servidor para el gráfico; el resto de la lógica vive en vehiculos-kilometraje.js
  window.historialTodos = <%- JSON.stringify(historial) %>;
</script>
<script src="/js/pages/vehiculos-kilometraje.js"></script>
<%- include('../partials/scripts') %>
