<%- include('../partials/head', { titulo: 'Nuevo Usuario', hojaEstilo: 'accesos-usuario-nuevo' }) %>

<div class="app-shell" id="appShell">
  <%- include('../partials/topbar', { usuario: usuario, notificaciones: notificaciones }) %>
  <%- include('../partials/sidebar', { activeModulo: 'accesos' }) %>

  <main class="app-main" style="overflow-y:auto">
    <div class="form-page">

      <a href="/accesos/usuarios" class="btn btn-sm btn-ghost btn-page-back">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        Volver a Usuarios
      </a>

      <div class="form-page-header">
        <div>
          <h1>Nuevo Usuario</h1>
          <p>Registrá un empleado y asignale un nivel de acceso.</p>
        </div>
      </div>

      <form action="/accesos/usuarios/nuevo" method="post">
        <section class="form-section">
          <h2>Datos Personales</h2>
          <div class="form-row">
            <div class="form-group"><label>Nombre <span class="req">*</span></label><input type="text" name="nombre" required></div>
            <div class="form-group"><label>Apellido <span class="req">*</span></label><input type="text" name="apellido" required></div>
          </div>
        </section>

        <section class="form-section">
          <h2>Credenciales de Acceso</h2>
          <div class="form-row">
            <div class="form-group"><label>Nombre de Usuario (Login) <span class="req">*</span></label><input type="text" name="nombre_usuario" required autocomplete="off"></div>
            <div class="form-group"><label>Contraseña Temporal <span class="req">*</span></label><input type="password" name="contrasena" required autocomplete="new-password"></div>
          </div>
          <div class="form-group is-small">
            <label>Rol del Usuario <span class="req">*</span></label>
            <select id="id_rol" name="id_rol" required>
              <% roles.forEach(function (r) { %><option value="<%= r.id %>"><%= r.nombre %></option><% }) %>
            </select>
          </div>
        </section>

        <section class="form-section">
          <h2>Permisos de Módulos</h2>
          <div id="cartel-admin" class="form-notice is-success" style="display:none">
            El rol de Administrador tiene acceso total a todos los módulos del sistema por defecto.
          </div>
          <div id="lista-permisos">
            <p class="field-hint">Seleccioná a qué secciones de la barra lateral tendrá acceso este usuario:</p>
            <div class="permisos-grid">
              <% permisos.forEach(function (p) { %>
                <label class="permiso-chip"><input type="checkbox" name="vistas" value="<%= p.clave %>"><%= p.etiqueta %></label>
              <% }) %>
              <% permisosAdmin.forEach(function (p) { %>
                <label class="permiso-chip is-sensible"><input type="checkbox" name="vistas" value="<%= p.clave %>"><%= p.etiqueta %></label>
              <% }) %>
            </div>
          </div>
        </section>

        <div class="form-actions">
          <a href="/accesos/usuarios" class="btn btn-outline">Cancelar</a>
          <button type="submit" class="btn btn-accent">Guardar Usuario</button>
        </div>
      </form>
    </div>
  </main>
</div>

<script src="/js/pages/accesos-usuario-nuevo.js"></script>
<%- include('../partials/scripts') %>
