<%- include('../partials/head', { titulo: 'Reportes y Análisis', hojaEstilo: 'reportes-index' }) %>

<div class="app-shell" id="appShell">
  <%- include('../partials/topbar', { usuario: usuario, notificaciones: notificaciones }) %>
  <%- include('../partials/sidebar', { activeModulo: 'reportes' }) %>

  <main class="app-main" style="overflow-y:auto">
    <div class="page-wrap">

      <div class="page-header-row">
        <div>
          <h1>Reportes y Análisis</h1>
          <p>Métricas financieras y operativas de la flota.</p>
        </div>
      </div>

      <form method="get" action="/reportes">
        <div class="card">
          <div class="card-body filter-bar" style="align-items:flex-end">
            <div class="form-group"><label>Fecha Desde</label><input type="date" name="fechaDesde" value="<%= fechaDesde %>"></div>
            <div class="form-group"><label>Fecha Hasta</label><input type="date" name="fechaHasta" value="<%= fechaHasta %>"></div>
            <button type="submit" class="btn btn-primary">Generar Reporte</button>
          </div>
        </div>
      </form>

      <div class="stat-grid">
        <div class="stat-card" style="cursor:default">
          <div>
            <span class="stat-card-label">Gasto Total en Mantenimientos</span>
            <span class="stat-card-value" style="color:var(--danger)"><%= estadisticas.costoTotalFormateado %></span>
          </div>
        </div>
        <div class="stat-card" style="cursor:default">
          <div>
            <span class="stat-card-label">Período Analizado</span>
            <span class="stat-card-value" style="font-size:16px"><%= periodoFormateado %></span>
          </div>
        </div>
      </div>

      <div class="chart-grid">
        <div class="card">
          <div class="card-header"><span class="card-title">Top Vehículos con Mayor Gasto</span></div>
          <div class="card-body">
            <% if (estadisticas.topVehiculos.length) { %>
              <div class="chart-canvas-wrap"><canvas id="chartTopVehiculos"></canvas></div>
            <% } else { %>
              <p class="table-empty">Sin mantenimientos registrados en el período.</p>
            <% } %>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><span class="card-title">Vehículos por Localidad</span></div>
          <div class="card-body donut-row">
            <div class="chart-donut-wrap">
              <canvas id="chartLocalidad"></canvas>
              <div class="donut-center"><strong><%= estadisticas.totalVehiculos %></strong><span>Total</span></div>
            </div>
            <div class="donut-legend">
              <% estadisticas.porLocalidad.forEach(function (d, i) { %>
                <div class="donut-legend-item"><span class="donut-legend-dot" style="background:<%= estadisticas.coloresLocalidad[i] %>"></span><%= d.localidad %><span class="donut-legend-value"><%= d.cantidad %></span></div>
              <% }) %>
            </div>
          </div>
        </div>

        <div class="card" style="grid-column:1/-1">
          <div class="card-header"><span class="card-title">Frecuencia de Tipos de Servicio en Taller</span></div>
          <div class="card-body">
            <div class="chart-canvas-wrap" style="height:<%= Math.max(180, estadisticas.porTipoServicio.length * 46) %>px"><canvas id="chartTipoServicio"></canvas></div>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><span class="card-title">Siniestros por Vehículo</span></div>
          <div class="card-body">
            <% if (estadisticas.siniestrosPorVehiculo.length) { %>
              <div class="chart-canvas-wrap"><canvas id="chartSiniestros"></canvas></div>
            <% } else { %>
              <p class="table-empty">Sin siniestros registrados en el período.</p>
            <% } %>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><span class="card-title">Choferes con Más Viajes de Comisión</span></div>
          <div class="card-body">
            <% if (estadisticas.choferesConMasViajes.length) { %>
              <div class="chart-canvas-wrap" style="height:<%= Math.max(180, estadisticas.choferesConMasViajes.length * 40) %>px"><canvas id="chartChoferes"></canvas></div>
            <% } else { %>
              <p class="table-empty">Sin viajes de comisión registrados todavía.</p>
            <% } %>
          </div>
        </div>

        <div class="card" style="grid-column:1/-1">
          <div class="card-header"><span class="card-title">Destinos Más Viajados</span></div>
          <div class="card-body donut-row">
            <% if (estadisticas.destinosMasFrecuentes.length) { %>
              <div class="chart-donut-wrap">
                <canvas id="chartDestinos"></canvas>
                <div class="donut-center"><strong><%= datosGraficos.totalViajes %></strong><span>Viajes</span></div>
              </div>
              <div class="donut-legend">
                <% estadisticas.destinosMasFrecuentes.forEach(function (d, i) { %>
                  <div class="donut-legend-item"><span class="donut-legend-dot" style="background:<%= datosGraficos.coloresDestinos[i] %>"></span><%= d.destino %><span class="donut-legend-value"><%= d.cantidad %></span></div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="table-empty">Sin viajes de comisión registrados todavía.</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<script type="application/json" id="reportes-chart-data"><%- JSON.stringify(datosGraficos).replace(/</g, '\\u003c') %></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script src="/js/pages/reportes-index.js"></script>
<%- include('../partials/scripts') %>
